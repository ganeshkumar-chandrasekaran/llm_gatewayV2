# Copy this file to ../.env (one directory up) and fill in your keys.
# All keys are optional — providers without keys are skipped.
# If no keys are set, the mock provider is used automatically.

GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

NVIDIA_API_KEY=
NVIDIA_MODEL=deepseek-ai/deepseek-v3.2

GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile

CEREBRAS_API_KEY=
CEREBRAS_MODEL=qwen-3-235b-a22b-instruct-2507

OPEN_ROUTER_API_KEY=
OPENROUTER_MODEL=nvidia/nemotron-3-super-120b-a12b:free

GITHUB_ACCESS_TOKEN=
GITHUB_MODEL=openai/gpt-4.1-mini

OLLAMA_URL=http://localhost:11434
OLLAMA_MODEL=

LLM_ORDER=mock,ollama,gemini,nvidia,groq,cerebras,openrouter,github
GATEWAY_V2_PORT=8100
